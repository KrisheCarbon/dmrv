# Copy to .env and fill in values (never commit .env)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token
# NestJS API on your laptop (localhost + adb reverse over USB, or http://<laptop-ip>:3001 over Wi‑Fi)
EXPO_PUBLIC_BACKEND_URL=http://localhost:3001
# Public Cognito app client. Same pool the admin site uses. Not a secret.
EXPO_PUBLIC_COGNITO_REGION=ap-south-1
EXPO_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_2xPIRaRaf
EXPO_PUBLIC_COGNITO_CLIENT_ID=2l94cete5s4e93fqbcvrjdvfui
