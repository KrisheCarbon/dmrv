# Copy to .env and fill in values (never commit .env)
PORT=3001

# Same Supabase project as Web and Mobile
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: direct Postgres URL for running SQL migrations locally
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# When set, table reads and writes go to this PostgREST (the AWS database).
# Login stays on Supabase. Leave unset for local Supabase.
# POSTGREST_URL=http://127.0.0.1:3000

# When set, photos, videos and documents are stored in private AWS buckets
# named ${S3_BUCKET_PREFIX}${bucket}. Leave unset to keep local files on Supabase.
# AWS_REGION=ap-south-1
# S3_BUCKET_PREFIX=krishecarbon-297433793590-

# Comma-separated origins for CORS
CORS_ORIGINS=http://localhost:3000
